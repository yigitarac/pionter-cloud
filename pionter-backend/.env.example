DATABASE_URL=postgres://admin:password@localhost:5432/piontercloud

# 32-byte base64 key.
# Generate with:
# openssl rand -base64 32
# Do not commit the real production/local key.
CREDENTIAL_ENCRYPTION_KEY=base64-encoded-32-byte-key

APP_PUBLIC_URL=http://localhost:3000

# Optional. Defaults to 8080 if empty.
PORT=8080

# Optional. If empty, backend falls back to APP_PUBLIC_URL.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Optional retention settings.
# Expired/revoked share links older than this many days may be cleaned.
SHARE_LINK_RETENTION_DAYS=90

# Activity logs older than this many days may be cleaned.
ACTIVITY_LOG_RETENTION_DAYS=180
